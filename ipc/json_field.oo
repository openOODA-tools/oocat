// # JSON Field Parser and String Escaping
//
// Logline: Extracts JSON fields and encodes strings for Model Context Protocol frames.
//
// Setup: Pure string utilities for parsing and serializing JSON-RPC envelopes.
//
// Beats:
//   1. Extract unquoted field values from simple and nested JSON payloads.
//   2. Extract quoted string values without brace tracking distortion.
//   3. Escape and unescape arbitrary characters into valid JSON string representations.

fn skip_string(json: String, i: Int) -> Int {
    let n: Int = chars_len(json);
    let mut j: Int = i + 1;
    while j < n {
        let c: String = char_at(json, j);
        if c == "\\" {
            j = j + 2;
        } else if c == "\"" {
            return j + 1;
        } else {
            j = j + 1;
        }
    }
    return n;
}

pub fn scan_balanced(json: String, start: Int) -> Int {
    let n: Int = chars_len(json);
    let mut depth: Int = 0;
    let mut i: Int = start;
    while i < n {
        let c: String = char_at(json, i);
        if c == "\"" {
            i = skip_string(json, i);
        } else {
            if c == "{" || c == "[" { depth = depth + 1; }
            else if c == "}" || c == "]" {
                depth = depth - 1;
                if depth == 0 { return i + 1; }
            }
            i = i + 1;
        }
    }
    return n;
}

pub fn skip_whitespace(json: String, start: Int) -> Int {
    let n: Int = chars_len(json);
    let mut j: Int = start;
    while j < n {
        let w: String = char_at(json, j);
        if w == " " || w == "\t" || w == "\n" || w == "\r" {
            j = j + 1;
        } else {
            return j;
        }
    }
    return n;
}

pub fn scan_json_object_end(buf: String, start: Int) -> Int {
    let n: Int = chars_len(buf);
    let mut depth: Int = 0;
    let mut i: Int = start;
    let mut found_open: Bool = false;
    while i < n {
        let c: String = char_at(buf, i);
        if c == "\"" {
            i = skip_string(buf, i);
        } else {
            if c == "{" {
                depth = depth + 1;
                found_open = true;
            } else if c == "}" {
                depth = depth - 1;
                if depth == 0 && found_open {
                    return i + 1;
                }
            }
            i = i + 1;
        }
    }
    return -1;
}

fn find_value_start(json: String, key: String) -> Int {
    let n: Int = chars_len(json);
    let mut depth: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(json, i);
        if c == "\"" {
            let after: Int = skip_string(json, i);
            if depth == 1 {
                let name: String = str_slice(json, i + 1, after - 1);
                let colon_pos: Int = skip_whitespace(json, after);
                if colon_pos < n && char_at(json, colon_pos) == ":" {
                    let val_pos: Int = skip_whitespace(json, colon_pos + 1);
                    if name == key {
                        return val_pos;
                    }
                    if val_pos < n {
                        let vc: String = char_at(json, val_pos);
                        if vc == "\"" {
                            i = skip_string(json, val_pos);
                        } else if vc == "{" || vc == "[" {
                            i = scan_balanced(json, val_pos);
                        } else {
                            let mut k: Int = val_pos;
                            while k < n {
                                let ch: String = char_at(json, k);
                                if ch == "," || ch == "}" || ch == " " || ch == "\t" || ch == "\n" || ch == "\r" { break; }
                                k = k + 1;
                            }
                            i = k;
                        }
                        continue;
                    }
                }
            }
            i = after;
        } else {
            if c == "{" || c == "[" { depth = depth + 1; }
            else if c == "}" || c == "]" { depth = depth - 1; }
            i = i + 1;
        }
    }
    return -1;
}

pub fn json_field_raw(json: String, key: String) -> String {
    let start: Int = find_value_start(json, key);
    let n: Int = chars_len(json);
    if start < 0 || start >= n { return ""; }
    let sc: String = char_at(json, start);
    if sc == "\"" {
        return str_slice(json, start, skip_string(json, start));
    }
    if sc == "{" || sc == "[" {
        return str_slice(json, start, scan_balanced(json, start));
    }
    let mut j: Int = start;
    while j < n {
        let c: String = char_at(json, j);
        if c == "," || c == "}" || c == "]" || c == " " || c == "\t" || c == "\n" || c == "\r" { break; }
        j = j + 1;
    }
    return str_slice(json, start, j);
}

pub fn json_field_string(json: String, key: String) -> String {
    let start: Int = find_value_start(json, key);
    let n: Int = chars_len(json);
    if start < 0 || start >= n { return ""; }
    if char_at(json, start) != "\"" { return ""; }
    let end: Int = skip_string(json, start);
    return json_unescape(str_slice(json, start + 1, end - 1));
}

pub fn json_escape(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        let b: Int = byte_at(c, 0);
        if b == 34 {
            out = out + "\\\"";
        } else if b == 92 {
            out = out + "\\\\";
        } else if b == 10 {
            out = out + "\\n";
        } else if b == 13 {
            out = out + "\\r";
        } else if b == 9 {
            out = out + "\\t";
        } else if b == 27 {
            out = out + "\\u001b";
        } else if b < 32 {
            out = out + " ";
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out;
}

pub fn json_unescape(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "\\" && i + 1 < n {
            let next_c: String = char_at(s, i + 1);
            if next_c == "n" {
                out = out + bytes_to_str(bytes_push(bytes_new(), 10));
                i = i + 2;
            } else if next_c == "r" {
                out = out + bytes_to_str(bytes_push(bytes_new(), 13));
                i = i + 2;
            } else if next_c == "t" {
                out = out + bytes_to_str(bytes_push(bytes_new(), 9));
                i = i + 2;
            } else if next_c == "\"" {
                out = out + "\"";
                i = i + 2;
            } else if next_c == "\\" {
                out = out + "\\";
                i = i + 2;
            } else if next_c == "u" && i + 5 < n {
                let hex: String = str_slice(s, i + 2, i + 6);
                if hex == "001b" || hex == "001B" {
                    out = out + bytes_to_str(bytes_push(bytes_new(), 27));
                    i = i + 6;
                } else {
                    out = out + next_c;
                    i = i + 2;
                }
            } else {
                out = out + next_c;
                i = i + 2;
            }
        } else {
            out = out + c;
            i = i + 1;
        }
    }
    return out;
}
