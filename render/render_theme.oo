// # Cat Theme Hydration - Token Color Resolver
//
// Logline: Hydrates terminal syntax colors from ~/.openooda/theme.oot and environment overrides.
//
// Setup: Pure string parser and token mapper. Operates with zero ambient authority.
//
// Beats:
//   1. Parse key-value bindings from theme.oot configuration text.
//   2. Map openOODA syntax tokens to 16/256-color ANSI codes per theme.
//   3. Resolve configuration path under openOODA home directory with $HOME fallback.

import "std/fs/process/env.oo";

pub fn ansi_esc() -> String {
    return bytes_to_str(bytes_push(bytes_new(), 27));
}

pub fn ansi_reset() -> String {
    return ansi_esc() + "[0m";
}

pub fn parse_theme_val(line: String, key: String) -> String {
    let trimmed: String = str_trim(line);
    if !str_starts_with(trimmed, key) { return ""; }
    let rest: String = str_trim(str_slice(trimmed, chars_len(key), chars_len(trimmed)));
    if !str_starts_with(rest, "=") { return ""; }
    let mut val: String = str_trim(str_slice(rest, 1, chars_len(rest)));
    if str_starts_with(val, "\"") && str_ends_with(val, "\"") {
        let n: Int = chars_len(val);
        if n >= 2 { val = str_slice(val, 1, n - 1); }
    }
    return val;
}

pub fn parse_theme_key(content: String, key: String) -> String {
    let n: Int = chars_len(content);
    let mut cur: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(content, i);
        if c == "\n" {
            let v: String = parse_theme_val(cur, key);
            if v != "" { return v; }
            cur = "";
        } else if c != "\r" {
            cur = cur + c;
        }
        i = i + 1;
    }
    if cur != "" {
        let v: String = parse_theme_val(cur, key);
        if v != "" { return v; }
    }
    return "";
}

pub fn token_ansi_code(kind: String, theme: String) -> String {
    if kind == "syntax_keyword" {
        if theme == "1982" || theme == "cyberpunk" || theme == "frost" { return "36"; }
        if theme == "amethyst" || theme == "dracula" { return "35"; }
        return "35";
    }
    if kind == "syntax_type" { return "34"; }
    if kind == "syntax_string" { return "32"; }
    if kind == "syntax_number" { return "33"; }
    if kind == "syntax_comment" { return "90"; }
    if kind == "syntax_op" { return "37"; }
    if kind == "syntax_fn" { return "36"; }
    if kind == "syntax_var" { return "33"; }
    if kind == "ui_border" { return "90"; }
    if kind == "ui_dim" { return "90"; }
    return "";
}

pub fn theme_config_path(home: String) -> String {
    if chars_len(home) == 0 { return "theme.oot"; }
    if str_ends_with(home, "/") {
        return home + ".openooda/theme.oot";
    }
    return home + "/.openooda/theme.oot";
}

pub fn resolve_cat_theme(fs: &FsReadCap, env: &EnvCap) -> String {
    let env_t: Result[String, String] = env_get(env, "OODA_THEME");
    if env_t.is_ok() {
        let t: String = match env_t { Ok(s) => s, Err(_) => "" };
        if t != "" { return t; }
    }
    let env_home: Result[String, String] = env_get(env, "OODA_HOME");
    let mut home: String = match env_home { Ok(s) => s, Err(_) => "" };
    if home == "" {
        let env_w: Result[String, String] = env_get(env, "OODA_FS_WRITEDIR");
        home = match env_w { Ok(s) => s, Err(_) => "" };
    }
    if home == "" {
        let env_h: Result[String, String] = env_get(env, "HOME");
        home = match env_h { Ok(s) => s, Err(_) => "" };
    }
    let p: String = theme_config_path(home);
    let r: Result[String, String] = read_file(fs, p);
    if r.is_err() { return "classic/1982"; }
    let content: String = match r { Ok(s) => s, Err(_) => "" };
    let t: String = parse_theme_key(content, "theme");
    return if t != "" { t } else { "classic/1982" };
}
