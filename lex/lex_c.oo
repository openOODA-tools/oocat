// # Lexer C - Systems C and Header File Tokenizer
//
// Logline: Parses C source code lines identifying preprocessor statements, keywords, and comments.
//
// Setup: Pure string scanning. Supports C99 line comments and multiline block comments.
//
// Beats:
//   1. Identify preprocessor directives beginning with hash sign.
//   2. Extract line comments and character or string literals.
//   3. Match fundamental C types and control structure keywords.

import "token_kind.oo";

fn is_c_keyword(w: String) -> Bool {
    return w == "return" || w == "if" || w == "else" || w == "while" ||
           w == "for" || w == "switch" || w == "case" || w == "break" ||
           w == "continue" || w == "default" || w == "goto" || w == "sizeof";
}

fn is_c_type(w: String) -> Bool {
    return w == "int" || w == "char" || w == "void" || w == "struct" ||
           w == "typedef" || w == "static" || w == "const" || w == "unsigned" ||
           w == "long" || w == "short" || w == "float" || w == "double" ||
           w == "size_t" || w == "ssize_t" || w == "uint8_t" || w == "uint32_t";
}

pub fn lex_line_c(line: String) -> List[Token] {
    let mut out: List[Token] = list_new();
    let n: Int = chars_len(line);
    let mut i: Int = 0;

    let trimmed: String = str_trim(line);
    if str_starts_with(trimmed, "#include") || str_starts_with(trimmed, "#define") || str_starts_with(trimmed, "#ifdef") || str_starts_with(trimmed, "#endif") || str_starts_with(trimmed, "#pragma") {
        out = list_push(out, token_keyword(line));
        return out;
    }

    while i < n {
        let c: String = char_at(line, i);

        if c == "/" && i + 1 < n && char_at(line, i + 1) == "/" {
            let comm: String = str_slice(line, i, n);
            out = list_push(out, token_comment(comm));
            return out;
        }

        if c == "\"" || c == "'" {
            let q: String = char_at(line, i);
            let mut j: Int = i + 1;
            while j < n {
                let sc: String = char_at(line, j);
                if sc == "\\" && j + 1 < n {
                    j = j + 2;
                } else if sc == q {
                    j = j + 1;
                    break;
                } else {
                    j = j + 1;
                }
            }
            out = list_push(out, token_string(str_slice(line, i, j)));
            i = j;
            continue;
        }

        if is_alpha_char(c) {
            let mut j: Int = i;
            while j < n && is_ident_char(char_at(line, j)) { j = j + 1; }
            let word: String = str_slice(line, i, j);
            if is_c_keyword(word) {
                out = list_push(out, token_keyword(word));
            } else if is_c_type(word) {
                out = list_push(out, token_type(word));
            } else if j < n && char_at(line, j) == "(" {
                out = list_push(out, token_fn(word));
            } else {
                out = list_push(out, token_text(word));
            }
            i = j;
            continue;
        }

        if is_digit_char(c) {
            let mut j: Int = i;
            while j < n && is_digit_char(char_at(line, j)) { j = j + 1; }
            out = list_push(out, token_number(str_slice(line, i, j)));
            i = j;
            continue;
        }

        out = list_push(out, token_text(c));
        i = i + 1;
    }

    return out;
}
